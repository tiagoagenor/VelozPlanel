{
  "name": "@velozplanel/agent",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:vps": "tsx watch src/vps-server.ts",
    "build:vps": "esbuild src/vps-server.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/vps-agent.mjs --banner:js=\"import{createRequire}from'module';const require=createRequire(import.meta.url);\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.0",
    "@velozplanel/contracts": "workspace:*",
    "@velozplanel/db-console": "workspace:*",
    "dockerode": "^4.0.0",
    "fastify": "^5.1.0",
    "pino": "^9.0.0",
    "pino-pretty": "^13.0.0",
    "zod": "^3.24.1",
    "ssh2": "^1.16.0"
  },
  "devDependencies": {
    "@types/dockerode": "^3.3.31",
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "@types/ssh2": "^1.15.0"
  }
}
