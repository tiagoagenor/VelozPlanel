# ─────────────────────────────────────────────────────────────────────────────
# VelozPlanel — plano de controle · TEMPLATE de variáveis de ambiente.
#
#   cp .env.example .env   &&   edite os valores   &&   NUNCA versione o .env
#   (o .gitignore já bloqueia *.env; só o .env.example entra no repo).
#
# Gere segredos fortes assim:
#   VP_JWT_SECRET / senhas:   openssl rand -base64 36
# Todos os valores abaixo são PLACEHOLDERS — troque antes de subir.
# ─────────────────────────────────────────────────────────────────────────────

# ── Postgres (banco de controle, interno à rede compose) ─────────────────────
POSTGRES_USER=veloz
POSTGRES_PASSWORD=TROQUE_postgres_forte
POSTGRES_DB=velozpanel
# A API monta a DATABASE_URL a partir das três acima:
#   postgres://POSTGRES_USER:POSTGRES_PASSWORD@postgres:5432/POSTGRES_DB
# (definida no compose; não precisa repetir aqui).

# ── MariaDB (bancos dos clientes) ────────────────────────────────────────────
MARIADB_ROOT_PASSWORD=TROQUE_mariadb_root_forte

# ── Rede WireGuard ───────────────────────────────────────────────────────────
# IP do hub (187) na interface WG. O MariaDB é publicado SÓ neste IP:3306 e é o
# host de banco devolvido aos clientes (VP_DB_PUBLIC_HOST no compose).
HUB_WG_IP=10.77.0.1
# URL do agente que a API usa (env único hoje — aponte para um nó via WG).
AGENT_URL=http://10.77.0.2:4100
# Host SSH mostrado ao cliente (cai para HUB_WG_IP se vazio).
VP_SSH_HOST=10.77.0.1

# ── API / sessão ─────────────────────────────────────────────────────────────
# Segredo de assinatura do JWT (cookie httpOnly `vp_session`).
VP_JWT_SECRET=TROQUE_jwt_secret_forte
# Cookie de sessão com flag Secure (1 = só HTTPS). Em produção atrás do Caddy: 1.
# NOTA: suporte a esta env está sendo adicionado na API (hoje `secure` é fixo).
VP_COOKIE_SECURE=1
# Origens autorizadas no CORS do painel (CSV). Atrás do Caddy, mesma origem:
#   https://SEU_DOMINIO  (ou https://IP_PUBLICO enquanto usa self-signed).
VP_PANEL_ORIGINS=https://localhost

# ── Seed do admin inicial ────────────────────────────────────────────────────
# Credenciais do primeiro super admin criado no push-and-seed.
# NOTA: leitura destas envs está sendo adicionada na API (confirmar nomes exatos
#       com o outro engenheiro antes do go-live).
VP_SEED_ADMIN_EMAIL=admin@exemplo.com
VP_SEED_ADMIN_PASSWORD=TROQUE_senha_admin_forte

# ── Caddy / endereço público ─────────────────────────────────────────────────
# Sem domínio: :443 (self-signed via `tls internal`).
# Com domínio: SITE_ADDRESS=meudominio.com  (e remova `tls internal` no Caddyfile).
SITE_ADDRESS=:443

# ── DNS autoritativo (PowerDNS) ──────────────────────────────────────────────
# Senha do backend gpgsql (database dedicado `pdns`). Definindo esta variável, o
# `db:push` cria o database/role/schema do pdns automaticamente. Vazia = sem DNS.
PDNS_DB_PASSWORD=TROQUE_pdns_db_forte
# Chave da HTTP API do pdns (a API do painel usa; nunca exposta publicamente).
PDNS_API_KEY=TROQUE_pdns_api_key_forte
# (opcional) nome/usuário do database do pdns — default pdns/pdns.
# PDNS_DB_NAME=pdns
# PDNS_DB_USER=pdns
# Nameservers deste servidor (o que o cliente cadastra no registrador).
#   ns1 = primário (este servidor, 187) · ns2 = secundário (184).
DNS_NS1_HOST=ns1.geestao.top
DNS_NS1_IP=187.127.49.205
DNS_NS2_HOST=ns2.geestao.top
DNS_NS2_IP=184.107.115.183
# IP público onde o pdns publica a porta 53 (evita 0.0.0.0 por causa do
# systemd-resolved no loopback). Normalmente = DNS_NS1_IP.
DNS_BIND_PUBLIC=187.127.49.205
# IP WireGuard do secundário (184) — usado em allow-axfr-ips/also-notify.
DNS_SECONDARY_WG=10.100.0.4
# (opcional) FQDNs/IPs da infra do painel — registros que apontam para eles ficam
# protegidos na edição (CSV). Ex.: gestao.geestao.top,187.127.49.205
PANEL_PROTECTED_TARGETS=
